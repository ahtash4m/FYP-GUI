      {
        "plan_id": 2,
        "acne_type": "acne-cystic",
        "severity": "Severe",
        "recommended_treatment": "Wash with a hydrating, non-foaming cleanser. Avoid harsh scrubbing which worsens inflammation. Spot treat cysts with a thin layer of 2.5% Benzoyl Peroxide to target deep bacteria. Apply a warm compress for 10 minutes to soothe pain, followed by a barrier-repairing moisturizer."
      },
      {
        "plan_id": 3,
        "acne_type": "acne-open-comedo",
        "severity": "Mild",
        "recommended_treatment": "Use a leave-on 2% Salicylic Acid (BHA) liquid exfoliant to dissolve oil inside the pore. Incorporate a Niacinamide serum to help regulate sebum production and visibly tighten pores. Apply an oil-free gel moisturizer to maintain hydration without clogging pores."
      },
      {
        "plan_id": 4,
        "acne_type": "acne-pustular",
        "severity": "Moderate",
        "recommended_treatment": "Wash your face twice daily with a gentle, non-comedogenic cleanser. Apply hydrocolloid pimple patches over active pustules to safely absorb fluid overnight. Apply a lightweight moisturizer to protect the skin barrier and prevent dryness."
      },
      {
        "plan_id": 5,
        "acne_type": "hidradenitis-suppurativa",
        "severity": "Severe",
        "recommended_treatment": "Wash the affected areas gently with an antibacterial soap. Apply warm compresses to painful nodules to help soothe inflammation. Wear loose-fitting clothing to minimize friction and consult a dermatologist."
      },
      {
        "plan_id": 6,
        "acne_type": "perioral-dermatitis",
        "severity": "Moderate",
        "recommended_treatment": "Stop using all harsh active ingredients, exfoliants, and heavy cosmetics immediately. Wash the area strictly with warm water or an ultra-mild, fragrance-free cleanser. Apply a thin layer of a basic, soothing zinc-based barrier cream and avoid steroid creams."
      },
      {
        "plan_id": 7,
